NEXT_PUBLIC_SITE_URL=https://www.pmbp.pl
NEXT_PUBLIC_PMBP_GITHUB_URL=
NEXT_PUBLIC_PMBP_DOWNLOAD_URL=

# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmbp?schema=public"

DEMO_NOTIFICATION_EMAIL_1=
DEMO_NOTIFICATION_EMAIL_2=
# Alternatywnie można podać listę rozdzieloną przecinkami:
DEMO_NOTIFICATION_EMAILS=

RESEND_API_KEY=
EMAIL_FROM="PMBP <powiadomienia@example.com>"

# Losowa, prywatna wartość używana wyłącznie do haszowania IP dla rate limitu.
RATE_LIMIT_SALT=
